PORT=5000
MONGO_URI=<your MongoDB Atlas connection string>
JWT_SECRET=<any long random string>

# Online payments (Razorpay) - optional, without these the app uses demo/cash payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email notifications (any SMTP provider, e.g. Gmail app password / Brevo / SendGrid) - optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Hostel Management <your-email@example.com>

# SMS notifications (Twilio) - optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
